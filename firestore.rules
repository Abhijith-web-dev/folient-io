rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Rules - Only owner can read/write their keys and credentials
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User Deployments list
    match /deployments/{deploymentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Published Sites Registry
    match /published-sites/{siteId} {
      allow read: if true; // Public directories mapping
      allow write: if request.auth != null;
    }

    // Terms Acceptance Records
    match /terms_acceptances/{acceptanceId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Newsletter Subscribers
    match /community/newsletter/subscribers/{subscriberId} {
      allow create: if true; // Public signup form
      allow read, update, delete: if false; // Admin only
    }

    // Community Showcase Portfolios
    match /community/showroom/portfolios/{portfolioId} {
      allow read: if true; // Public showroom grid
      allow create: if request.auth != null;
      allow update: if request.auth != null; // Allow likes update
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Community Shared Templates
    match /community/showroom/templates/{templateId} {
      allow read: if true; // Public discovery feed
      allow create: if request.auth != null;
      allow update: if request.auth != null; // Allow usedCount and upvotes increment
    }

    // Community Shared Creator Assets
    match /community/showroom/assets/{assetId} {
      allow read: if true; // Public assets download drawer
      allow create: if request.auth != null;
      allow update: if request.auth != null; // Allow download counters increment
    }
  }
}
